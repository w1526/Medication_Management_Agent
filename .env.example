# Copy this file to .env, then fill the key locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=deepseek-v4-flash
DSH_PROFILE=sdk-minimal

# Phase 1 voice reminder delivery. local keeps the Web MVP offline.
MEDICATION_DEVICE_ADAPTER=local
# Set MEDICATION_DEVICE_ADAPTER=http to call the external Chat Agent.
CHAT_AGENT_BASE_URL=http://127.0.0.1:19090
CHAT_AGENT_REMINDER_PATH=/api/v1/chat-agent/reminders
CHAT_AGENT_TIMEOUT_SECONDS=5
CHAT_AGENT_API_TOKEN=

# Phase 3 M2 deterministic safety gate.  The empty provider is intentional:
# no clinical DDI/dose/allergy/contraindication rules are claimed by default.
SAFETY_ENABLED=1
SAFETY_RULE_PROVIDER=empty
SAFETY_RULESET_VERSION=empty-v1
SAFETY_RULE_FILE=

# Phase 2 M6 escalation. These are engineering/test defaults, not clinical guidance.
ESCALATION_ENABLED=1
ESCALATION_CAREGIVER_TIMEOUT_MINUTES=30
ESCALATION_FAMILY_TIMEOUT_MINUTES=60
ESCALATION_ACK_RESOLUTION_TIMEOUT_MINUTES=30
ESCALATION_REPEAT_MISSED_COUNT=2
ESCALATION_REPEAT_MISSED_LOOKBACK_HOURS=24
ESCALATION_SKIP_TRIGGER_COUNT=3
ESCALATION_SKIP_LOOKBACK_HOURS=24
ESCALATION_SILENCE_WINDOW_MINUTES=0

